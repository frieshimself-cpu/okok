# Required for the live Claude engine. Without it the site runs in demo mode
# (clearly-labelled heuristic picks) so you can develop and deploy first.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional: override the analysis model. Defaults to claude-opus-4-8.
# claude-haiku-4-5 is the budget option if API spend matters more than pick quality.
CLAUDE_MODEL=
